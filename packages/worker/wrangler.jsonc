{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-sweeper",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",

  // El propio Worker sirve el cliente compilado: un solo origen, sin CORS, y
  // `defaultServerUrl()` del cliente sigue apuntando al mismo sitio sin configurar nada.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Una sala = un Durable Object, direccionado por su codigo. Y un unico objeto mas para
  // la cola de emparejamiento, que solo guarda que sala espera por cada combinacion.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "QUEUE", "class_name": "Queue" }
    ]
  },

  // Respaldo SQLite: es el que esta disponible en el plan gratuito.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Queue"] }
  ],

  "observability": { "enabled": true }
}
